{
  "name": "HackHub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": " turbo dev",
    "build": "turbo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:studio": "pnpm --filter @workspace/database db:studio",
    "db:seed-admin": "pnpm --filter admin-service seed-admin",
    "docker:start": "docker compose up -d --build && docker compose rm -sf migrate && docker compose --profile tools run --rm seed-admin || echo [docker:start] seed-admin skipped - set ADMIN_EMAIL and ADMIN_PASSWORD in .env",
    "docker:up": "docker compose up -d --build && docker compose rm -sf migrate",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:restart": "docker compose restart",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:seed-admin": "docker compose --profile tools run --rm seed-admin",
    "docker:infra": "docker compose up -d postgres redis lgtm",
    "docker:obs": "docker compose up -d lgtm",
    "docker:clean": "docker compose down -v --rmi local"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
